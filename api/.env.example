# Copy to .env and adjust.
PORT=4000
NODE_ENV=development

# Allowed browser origins for CORS (comma separated)
WEB_ORIGIN=http://localhost:3000

# PostgreSQL connection string.
# Leave DATABASE_URL empty to use the embedded PGlite database (no install needed).
# Start a real Postgres with `npm run db:up` and uncomment the line below.
DATABASE_URL=
# DATABASE_URL=postgres://kindred:kindred@localhost:5432/kindredtap

# Signing secret for auth tokens. Change this for anything real.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Gemini API key for semantic matching (backend only, never exposed to frontend)
GEMINI_API_KEY=

# Set to "true" to hard-fail instead of silently falling back to PGlite
# when DATABASE_URL is unreachable.
DB_STRICT=false
