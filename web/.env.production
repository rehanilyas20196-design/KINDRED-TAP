# Baked into the client bundle at build time. Must be the API origin only:
# no /api suffix and no trailing slash, or every request resolves wrongly.
# A value already set in the Vercel dashboard takes precedence over this file.
#
# Option A: this is the API project's origin, NOT this app's own. The API
# project keeps the kindred-tap.vercel.app domain; this web app is a separate
# Vercel project. If the API ever moves to its own hostname, change this to
# match and set WEB_ORIGIN on the API project to this app's origin.
NEXT_PUBLIC_API_URL=https://kindred-tap.vercel.app
